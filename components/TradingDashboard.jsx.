'use client';

import React, { useEffect, useRef, useState } from 'react';
import { TrendingUp, TrendingDown, Target, ShieldAlert, BarChart2 } from 'lucide-react';

export default function TradingDashboard() {
  const chartContainerRef = useRef(null);
  const [currentPrice, setCurrentPrice] = useState(2045.50);
  const [dayHigh, setDayHigh] = useState(2058.20);
  const [dayLow, setDayLow] = useState(2038.10);

  const [entryPrice, setEntryPrice] = useState(2042.00);
  const [stopLoss, setStopLoss] = useState(2035.00);
  const [takeProfit1, setTakeProfit1] = useState(2055.00);
  const [takeProfit2, setTakeProfit2] = useState(2065.00);

  const risk = Math.abs(entryPrice - stopLoss);
  const reward1 = Math.abs(takeProfit1 - entryPrice);
  const riskRewardRatio = risk > 0 ? (reward1 / risk).toFixed(2) : '0.00';
  const rangePosition = (((currentPrice - dayLow) / (dayHigh - dayLow)) * 100).toFixed(1);

  useEffect(() => {
    // Prevent SSR execution
    if (typeof window === 'undefined' || !chartContainerRef.current) return;

    let chart;
    import('lightweight-charts').then(({ createChart }) => {
      chart = createChart(chartContainerRef.current, {
        width: chartContainerRef.current.clientWidth,
        height: 450,
        layout: {
          backgroundColor: '#0f172a',
          textColor: '#94a3b8',
        },
        grid: {
          vertLines: { color: '#1e293b' },
          horzLines: { color: '#1e293b' },
        },
        timeScale: { timeVisible: true },
      });

      const candleSeries = chart.addCandlestickSeries({
        upColor: '#22c55e',
        downColor: '#ef4444',
        borderVisible: false,
        wickUpColor: '#22c55e',
        wickDownColor: '#ef4444',
      });

      const now = Math.floor(Date.now() / 1000);
      const mockData = Array.from({ length: 40 }, (_, i) => {
        const time = now - (40 - i) * 900;
        const base = 2040 + Math.sin(i / 3) * 8;
        return {
          time,
          open: base - 1,
          high: base + 3,
          low: base - 2,
          close: base + 1,
        };
      });

      candleSeries.setData(mockData);

      candleSeries.createPriceLine({ price: entryPrice, color: '#3b82f6', title: 'ENTRY' });
      candleSeries.createPriceLine({ price: stopLoss, color: '#ef4444', title: 'SL' });
      candleSeries.createPriceLine({ price: takeProfit1, color: '#22c55e', title: 'TP 1' });
      candleSeries.createPriceLine({ price: takeProfit2, color: '#10b981', title: 'TP 2' });

      const handleResize = () => {
        if (chartContainerRef.current) {
          chart.applyOptions({ width: chartContainerRef.current.clientWidth });
        }
      };
      window.addEventListener('resize', handleResize);
    });

    return () => {
      if (chart) chart.remove();
    };
  }, [entryPrice, stopLoss, takeProfit1, takeProfit2]);

  return (
    <div style={{ backgroundColor: '#090d16', color: '#f8fafc', padding: '24px', borderRadius: '12px', fontFamily: 'sans-serif' }}>
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(180px, 1fr))', gap: '16px', marginBottom: '24px' }}>
        <div style={{ background: '#1e293b', padding: '16px', borderRadius: '8px' }}>
          <span style={{ color: '#94a3b8', fontSize: '12px' }}>Live Gold (XAU/USD)</span>
          <h2 style={{ margin: '4px 0 0 0', color: '#f59e0b', fontSize: '24px' }}>${currentPrice.toFixed(2)}</h2>
        </div>
        <div style={{ background: '#1e293b', padding: '16px', borderRadius: '8px' }}>
          <span style={{ color: '#94a3b8', fontSize: '12px' }}>24h Range High / Low</span>
          <p style={{ margin: '4px 0 0 0', fontWeight: 'bold' }}>
            <span style={{ color: '#22c55e' }}>${dayHigh}</span> / <span style={{ color: '#ef4444' }}>${dayLow}</span>
          </p>
        </div>
        <div style={{ background: '#1e293b', padding: '16px', borderRadius: '8px' }}>
          <span style={{ color: '#94a3b8', fontSize: '12px' }}>Risk : Reward Ratio</span>
          <h3 style={{ margin: '4px 0 0 0', color: '#3b82f6' }}>1 : {riskRewardRatio}</h3>
        </div>
        <div style={{ background: '#1e293b', padding: '16px', borderRadius: '8px' }}>
          <span style={{ color: '#94a3b8', fontSize: '12px' }}>Intraday Position</span>
          <h3 style={{ margin: '4px 0 0 0', color: '#e2e8f0' }}>{rangePosition}% of Range</h3>
        </div>
      </div>

      <div style={{ display: 'grid', gridTemplateColumns: '2fr 1fr', gap: '24px' }}>
        <div style={{ background: '#0f172a', padding: '16px', borderRadius: '8px' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '12px' }}>
            <span style={{ fontWeight: 'bold', display: 'flex', alignItems: 'center', gap: '8px' }}>
              <BarChart2 size={18} color="#f59e0b" /> Technical Level Overlay
            </span>
            <span style={{ color: '#22c55e', fontSize: '12px' }}>● Live Feed Active</span>
          </div>
          <div ref={chartContainerRef} style={{ width: '100%', height: '450px' }} />
        </div>

        <div style={{ background: '#1e293b', padding: '20px', borderRadius: '8px' }}>
          <h3 style={{ marginTop: 0, color: '#f8fafc', fontSize: '16px' }}>Target & Stop Level Controls</h3>
          
          <div style={{ marginBottom: '16px' }}>
            <label style={{ color: '#94a3b8', fontSize: '12px', display: 'block', marginBottom: '4px' }}>Entry Price ($)</label>
            <input 
              type="number" 
              value={entryPrice} 
              onChange={(e) => setEntryPrice(Number(e.target.value))}
              style={{ width: '100%', padding: '8px', background: '#0f172a', border: '1px solid #334155', color: '#fff', borderRadius: '4px' }}
            />
          </div>

          <div style={{ marginBottom: '16px' }}>
            <label style={{ color: '#ef4444', fontSize: '12px', display: 'block', marginBottom: '4px' }}>Stop Loss ($)</label>
            <input 
              type="number" 
              value={stopLoss} 
              onChange={(e) => setStopLoss(Number(e.target.value))}
              style={{ width: '100%', padding: '8px', background: '#0f172a', border: '1px solid #334155', color: '#fff', borderRadius: '4px' }}
            />
          </div>

          <div style={{ marginBottom: '16px' }}>
            <label style={{ color: '#22c55e', fontSize: '12px', display: 'block', marginBottom: '4px' }}>Take Profit 1 ($)</label>
            <input 
              type="number" 
              value={takeProfit1} 
              onChange={(e) => setTakeProfit1(Number(e.target.value))}
              style={{ width: '100%', padding: '8px', background: '#0f172a', border: '1px solid #334155', color: '#fff', borderRadius: '4px' }}
            />
          </div>

          <div style={{ marginBottom: '24px' }}>
            <label style={{ color: '#10b981', fontSize: '12px', display: 'block', marginBottom: '4px' }}>Take Profit 2 ($)</label>
            <input 
              type="number" 
              value={takeProfit2} 
              onChange={(e) => setTakeProfit2(Number(e.target.value))}
              style={{ width: '100%', padding: '8px', background: '#0f172a', border: '1px solid #334155', color: '#fff', borderRadius: '4px' }}
            />
          </div>

          <button style={{ width: '100%', padding: '12px', background: '#f59e0b', color: '#000', fontWeight: 'bold', border: 'none', borderRadius: '6px', cursor: 'pointer' }}>
            Sync Technical Levels
          </button>
        </div>
      </div>
    </div>
  );
}
